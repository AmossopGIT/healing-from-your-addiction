{
  "name": "healing-from-your-addiction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "prebuild": "node tools/site-archiver/scripts/generate-case-study-static-redirects.mjs && npm run cms:backfill",
    "cms:backfill": "tsx scripts/cms-backfill.ts",
    "redirects:case-studies": "node tools/site-archiver/scripts/export-case-study-slug-migration.mjs && node tools/site-archiver/scripts/apply-case-study-redirects.mjs && node tools/site-archiver/scripts/generate-case-study-static-redirects.mjs",
    "cms:sync-seo-keywords": "node tools/cms/sync-seo-keywords.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "programmes:validate": "tsx scripts/validate-interactive-programmes.mts",
    "start": "next start",
    "archive:site": "npm --prefix \"tools/site-archiver\" run start --",
    "video:render": "powershell -ExecutionPolicy Bypass -File boilerplate/lyric-video-kit/scripts/render_lyric_video_loop.ps1 -ProjectRoot .",
    "video:sync": "powershell -ExecutionPolicy Bypass -File boilerplate/lyric-video-kit/scripts/sync_lyrics_from_config.ps1 -ProjectRoot .",
    "video:align": "python boilerplate/lyric-video-kit/scripts/align_lyrics_whisper.py",
    "video:validate": "powershell -ExecutionPolicy Bypass -File boilerplate/lyric-video-kit/scripts/validate_lyric_video_config.ps1 -ProjectRoot .",
    "social:render": "powershell -ExecutionPolicy Bypass -File boilerplate/social-video-kit/scripts/render_social_exports.ps1 -ProjectRoot .",
    "social:validate": "powershell -ExecutionPolicy Bypass -File boilerplate/social-video-kit/scripts/validate_social_config.ps1 -ProjectRoot .",
    "social:previews": "powershell -ExecutionPolicy Bypass -File boilerplate/social-video-kit/scripts/generate_safe_zone_previews.ps1 -ProjectRoot ."
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "framer-motion": "^12.38.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.22.4",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
